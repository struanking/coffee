---
import Footer from '../components/footer.astro';
import Head from '../components/head.astro';
import Header from '../components/header.astro';
import Main from '../components/main.astro';

// TODO fix conflict between <head> and <Head/>
// TODO use page title and description from site config?
const defaultTitle = 'My coffee bean blog';
const defaultDescription = 'Catalogue of coffee beans';
const { title, description } = Astro.props;
const metaTitle = [title, defaultTitle].filter((x) => x).join(' - ');
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={metaTitle} description={description || defaultDescription} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <Main>
      <slot />
    </Main>
    <Footer />
  </body>
</html>
