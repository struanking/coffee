---
import { getCollection } from 'astro:content';
import { client } from '../../tina/__generated__/client';
import AutoGrid from '../components/auto-grid.astro';
import BaseLayout from '../layouts/base.astro';
import '../styles/compositions/grid.css';
// const coffeesResponse = await client.queries.coffeeConnection();
// const coffees = coffeesResponse.data.coffeeConnection.edges;
// const coffees = [];
const coffees = await getCollection('coffee');
// console.log(coffees);
---

<BaseLayout title="Coffee home">
  <h1 class="text-xl">This is a title</h1>
  <AutoGrid>
    {
      coffees?.map((coffee) => (
        <div class="p-4 bg-red-200 w-fit">
          <>
            <p>{coffee?.id}</p>
            <p>{coffee?.data.title}</p>
          </>
        </div>
      ))
    }
    <!-- {coffees?.map((coffee) => <p>{coffee?.node?.title}</p>)} -->
    <!-- {coffees?.map((coffee) => <Card coffee={coffee} />)} -->
  </AutoGrid>
  <hr />
  <div class="grid-auto">
    {
      coffees?.map((coffee) => (
        <div class="p-4 bg-red-200 w-fit">
          <>
            <p>{coffee?.id}</p>
            <p>{coffee?.data.title}</p>
          </>
        </div>
      ))
    }
  </div>
</BaseLayout>
